          "typeVersion": 4,
          "position": [900, 600],
          "parameters": {
            "method": "GET",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/weekly_stats?customer_id=eq.{{$json.id}}&order=week_start.desc&limit=1",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "apikey",
                  "value": "={{$env.SUPABASE_SERVICE_KEY}}"
                },
