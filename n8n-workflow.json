                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"from\": \"Inference Agents <hello@inference-agents.com>\",\n  \"to\": [\"{{$('Extract Customer Data').item.json.email}}\"],\n  \"subject\": \"Your AI agent is live!\",\n  \"html\": \"<p>Your agent is live and handling enquiries. View your dashboard at https://inference-agents.com/portal.html?token={{$('Create Supabase Customer').item.json[0].portal_token}}</p>\"\n}"
          }
        },
        {
          "id": "node-weekly-schedule",
          "name": "Schedule: Weekly Digest",
          "type": "n8n-nodes-base.scheduleTrigger",
          "typeVersion": 1,
          "position": [240, 600],
          "parameters": {
            "rule": {
              "interval": [
                {
                  "field": "cronExpression",
                  "expression": "0 9 * * 1"
                }
              ]
            }
          }
        },
