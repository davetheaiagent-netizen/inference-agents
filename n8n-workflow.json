            }
          }
        },
        {
          "id": "node-generate-digest",
          "name": "Generate Digest Summary (Claude)",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [1120, 600],
          "parameters": {
            "method": "POST",
            "url": "https://api.anthropic.com/v1/messages",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "x-api-key",
                  "value": "={{$env.ANTHROPIC_API_KEY}}"
                },
                {
                  "name": "anthropic-version",
                  "value": "2023-06-01"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 300,\n  \"system\": \"You are a friendly AI assistant writing a brief weekly summary for a small business owner. Write in UK English. Be warm, encouraging, and concise. Exactly 3 sentences.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a friendly 3-sentence summary of this week's AI agent performance for {{$('Split Into Individual Customers').item.json.business_name}}: They handled {{$json[0].enquiries_handled}} enquiries, sent {{$json[0].messages_sent}} messages, saved approximately {{$json[0].hours_saved}} hours, and had {{$json[0].escalations}} escalations to a human. Keep it positive and encouraging.\"\n    }\n  ]\n}"
          }
        },
        {
          "id": "node-send-weekly-digest",
          "name": "Send Weekly Digest Email",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [1340, 600],
          "parameters": {
            "method": "POST",
            "url": "https://api.resend.com/emails",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.RESEND_API_KEY}}"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"from\": \"Inference Agents <hello@inference-agents.com>\",\n  \"to\": [\"{{$('Split Into Individual Customers').item.json.email}}\"],\n  \"subject\": \"Your AI agent weekly report — week of {{$now.format('d MMMM yyyy')}}\",\n  \"html\": \"<h2>Your week with AI</h2><p>{{$json.content[0].text}}</p><p>Enquiries: {{$('Get Week Stats per Customer').item.json[0].enquiries_handled}} | Hours saved: {{$('Get Week Stats per Customer').item.json[0].hours_saved}} | Messages: {{$('Get Week Stats per Customer').item.json[0].messages_sent}} | Escalations: {{$('Get Week Stats per Customer').item.json[0].escalations}}</p><p><a href='https://inference-agents.com/portal.html?token={{$('Split Into Individual Customers').item.json.portal_token}}'>View Dashboard</a></p>\"\n}"
          }
        }
      ],
