{
  "meta": {
    "instanceId": "inference-agents-n8n-instance"
  },
  "workflows": [
    {
      "id": "workflow-onboarding-001",
      "name": "Inference Agents — Master Onboarding & Agent Loop",
      "active": true,
      "nodes": [
        {
          "id": "node-stripe-trigger",
          "name": "Stripe Trigger",
          "type": "n8n-nodes-base.stripeTrigger",
          "typeVersion": 1,
          "position": [240, 300],
          "parameters": {
            "events": ["checkout.session.completed"]
          },
          "credentials": {
            "stripeApi": {
              "id": "stripe-cred-01",
              "name": "Stripe API"
            }
          }
        },
        {
          "id": "node-extract-customer",
          "name": "Extract Customer Data",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [460, 300],
          "parameters": {
            "jsCode": "// Extract customer data from Stripe checkout.session.completed event\nconst event = $input.first().json;\nconst session = event.data ? event.data.object : event;\n\n// Map amount_total (pence) to plan tier\nconst amountPaid = session.amount_total || 0;\nlet plan = 'starter';\nif (amountPaid >= 39900) {\n  plan = 'fullstack';\n} else if (amountPaid >= 19900) {\n  plan = 'growth';\n} else if (amountPaid >= 9900) {\n  plan = 'starter';\n}\n\nconst customerEmail = session.customer_details?.email || session.customer_email || '';\nconst customerName = session.customer_details?.name || '';\nconst stripeCustomerId = session.customer || '';\nconst stripeSubscriptionId = session.subscription || '';\n\nreturn [\n  {\n    json: {\n      email: customerEmail,\n      name: customerName,\n      plan,\n      amount_paid: amountPaid,\n      stripe_customer_id: stripeCustomerId,\n      stripe_subscription_id: stripeSubscriptionId\n    }\n  }\n];"
          }
        },
        {
          "id": "node-create-supabase-customer",
          "name": "Create Supabase Customer",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [680, 300],
          "parameters": {
            "method": "POST",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/customers",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "apikey",
                  "value": "={{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                },
                {
                  "name": "Prefer",
                  "value": "return=representation"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"email\": \"{{$json.email}}\",\n  \"name\": \"{{$json.name}}\",\n  \"plan\": \"{{$json.plan}}\",\n  \"status\": \"onboarding\",\n  \"stripe_customer_id\": \"{{$json.stripe_customer_id}}\",\n  \"stripe_subscription_id\": \"{{$json.stripe_subscription_id}}\"\n}"
          }
        },
        {
          "id": "node-send-welcome-email",
          "name": "Send Welcome Email (Resend)",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [900, 300],
          "parameters": {
            "method": "POST",
            "url": "https://api.resend.com/emails",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.RESEND_API_KEY}}"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"from\": \"Inference Agents <hello@inference-agents.com>\",\n  \"to\": [\"{{$('Extract Customer Data').item.json.email}}\"],\n  \"subject\": \"Your AI agent is being set up — here's what happens next\",\n  \"html\": \"<p>Welcome to Inference Agents! Please complete your setup at https://inference-agents.com/onboarding.html?token={{$json[0].portal_token}}</p>\"\n}"
          }
        },
        {
          "id": "node-wait-form",
          "name": "Wait for Form Submission",
          "type": "n8n-nodes-base.webhook",
          "typeVersion": 2,
          "position": [1120, 300],
          "webhookId": "tally-form-submission",
          "parameters": {
            "httpMethod": "POST",
            "path": "onboarding-form",
            "responseMode": "onReceived",
            "responseData": "allEntries",
            "options": {}
          }
        },
        {
          "id": "node-update-agent-config",
          "name": "Update Agent Config in Supabase",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [1340, 300],
          "parameters": {
            "method": "POST",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/agent_configs",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "apikey",
                  "value": "={{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                },
                {
                  "name": "Prefer",
                  "value": "return=representation"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"customer_id\": \"{{$json.body.customer_id}}\",\n  \"agent_type\": \"{{$json.body.agent_type}}\",\n  \"business_name\": \"{{$json.body.business_name}}\",\n  \"sector\": \"{{$json.body.sector}}\",\n  \"tone\": \"{{$json.body.tone}}\",\n  \"faqs\": {{$json.body.faqs}},\n  \"escalation_name\": \"{{$json.body.escalation_name}}\",\n  \"escalation_phone\": \"{{$json.body.escalation_phone}}\",\n  \"whatsapp_number\": \"{{$json.body.whatsapp_number}}\",\n  \"email_address\": \"{{$json.body.email_address}}\",\n  \"website_url\": \"{{$json.body.website_url}}\",\n  \"channels\": {{$json.body.channels}},\n  \"is_active\": false\n}"
          }
        },
        {
          "id": "node-generate-system-prompt",
          "name": "Generate System Prompt (Claude)",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [1560, 300],
          "parameters": {
            "method": "POST",
            "url": "https://api.anthropic.com/v1/messages",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "x-api-key",
                  "value": "={{$env.ANTHROPIC_API_KEY}}"
                },
                {
                  "name": "anthropic-version",
                  "value": "2023-06-01"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 1200,\n  \"system\": \"You are an expert AI agent configurator for a UK AI automation agency. Your job is to write precise, effective system prompts for AI agents that handle customer enquiries for small businesses. Always write in UK English. The prompts should be professional, warm, and practical. Keep the system prompt under 800 words.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate a comprehensive system prompt for an AI agent with the following business details:\\n\\nBusiness name: {{$('Update Agent Config in Supabase').item.json.business_name}}\\nSector: {{$('Update Agent Config in Supabase').item.json.sector}}\\nDesired tone: {{$('Update Agent Config in Supabase').item.json.tone}}\\nWebsite: {{$('Update Agent Config in Supabase').item.json.website_url}}\\nEscalation contact: {{$('Update Agent Config in Supabase').item.json.escalation_name}} on {{$('Update Agent Config in Supabase').item.json.escalation_phone}}\\nFAQs: {{JSON.stringify($('Update Agent Config in Supabase').item.json.faqs)}}\\n\\nThe agent will handle inbound customer enquiries via WhatsApp and email. Write the system prompt now.\"\n    }\n  ]\n}"
          }
        },
        {
          "id": "node-save-system-prompt",
          "name": "Save System Prompt",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [1780, 300],
          "parameters": {
            "method": "PATCH",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/agent_configs?customer_id=eq.{{$('Update Agent Config in Supabase').item.json.customer_id}}",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "apikey",
                  "value": "={{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                },
                {
                  "name": "Prefer",
                  "value": "return=representation"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "={\n  \"system_prompt\": \"{{$json.content[0].text}}\",\n  \"is_active\": true\n}"
          }
        },
        {
          "id": "node-activate-customer",
          "name": "Activate Customer in Supabase",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [2000, 300],
          "parameters": {
            "method": "PATCH",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/customers?id=eq.{{$('Update Agent Config in Supabase').item.json.customer_id}}",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "apikey",
                  "value": "={{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                },
                {
                  "name": "Prefer",
                  "value": "return=representation"
                }
              ]
            },
            "sendBody": true,
            "bodyContentType": "json",
            "jsonBody": "{\n  \"status\": \"active\"\n}"
          }
        },
        {
          "id": "node-send-preview-email",
          "name": "Send Agent Live Email",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [2220, 300],
          "parameters": {
            "method": "POST",
            "url": "https://api.resend.com/emails",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "Authorization",
