    {
      "id": "workflow-whatsapp-002",
      "name": "WhatsApp Message Handler",
      "active": true,
      "nodes": [
        {
          "id": "node-360-webhook",
          "name": "360Dialog Webhook",
          "type": "n8n-nodes-base.webhook",
          "typeVersion": 2,
          "position": [240, 300],
          "webhookId": "360dialog-inbound",
          "parameters": {
            "httpMethod": "POST",
            "path": "whatsapp-inbound",
            "responseMode": "onReceived",
            "responseData": "allEntries",
            "options": {}
          }
        },
        {
          "id": "node-extract-wa-message",
          "name": "Extract WhatsApp Message",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [460, 300],
          "parameters": {
            "jsCode": "// Parse 360Dialog webhook payload\nconst body = $input.first().json.body || $input.first().json;\nconst messages = body.messages || [];\nconst contacts = body.contacts || [];\n\nif (!messages.length) {\n  // No messages to process (could be a status update)\n  return [];\n}\n\nconst msg = messages[0];\nconst contact = contacts[0] || {};\n\nconst fromNumber = msg.from;                          // sender's WhatsApp number\nconst toNumber = body.metadata?.phone_number_id || '';// our business number\nconst messageText = msg.type === 'text' ? msg.text?.body : '[Non-text message]';\nconst contactName = contact.profile?.name || 'Customer';\nconst messageId = msg.id;\n\nreturn [\n  {\n    json: {\n      from_number: fromNumber,\n      to_number: toNumber,\n      message_text: messageText,\n      contact_name: contactName,\n      message_id: messageId,\n      timestamp: msg.timestamp\n    }\n  }\n];"
          }
        },
        {
          "id": "node-get-customer-config",
          "name": "Get Customer Config",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [680, 300],
          "parameters": {
            "method": "GET",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/agent_configs?whatsapp_number=eq.{{$json.to_number}}&is_active=eq.true&select=*,customers(id,email,name,business_name,plan,status)",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "apikey",
                  "value": "={{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
                }
              ]
            }
          }
        },
        {
          "id": "node-get-conversation-history",
          "name": "Get Recent Conversation History",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [900, 300],
          "parameters": {
            "method": "GET",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/conversations?customer_id=eq.{{$json[0].customer_id}}&contact_identifier=eq.{{$('Extract WhatsApp Message').item.json.from_number}}&channel=eq.whatsapp&order=created_at.desc&limit=10&select=direction,message_content",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "apikey",
                  "value": "={{$env.SUPABASE_SERVICE_KEY}}"
                },
                {
                  "name": "Authorization",
                  "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
                }
              ]
            }
          }
        },
        {
          "id": "node-call-claude",
          "name": "Call Claude API",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4,
          "position": [1120, 300],
          "parameters": {
            "method": "POST",
            "url": "https://api.anthropic.com/v1/messages",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "x-api-key",
                  "value": "={{$env.ANTHROPIC_API_KEY}}"
                },
                {
                  "name": "anthropic-version",
                  "value": "2023-06-01"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
